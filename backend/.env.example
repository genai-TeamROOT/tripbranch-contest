# 애플리케이션 실행 환경: local | development | production
APP_ENV=local

# 브라우저에서 이 API를 부를 수 있는 출처. 쉼표로 여러 개를 준다.
# 워킹트리를 두 개 이상 띄우면 두 번째 프론트엔드가 5173을 못 써서 다른 포트로
# 뜨는데, 그때 여기에 그 포트를 더해야 화면이 백엔드를 부를 수 있다.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Provider 선택: 공통 기본값은 PROVIDER_MODE이며 개별 값으로 덮어쓸 수 있다.
PROVIDER_MODE=fake
LLM_PROVIDER=fake
WEATHER_PROVIDER=
PLACE_PROVIDER=
GEOCODING_PROVIDER=
CONCENTRATION_PROVIDER=
SEOUL_CITYDATA_PROVIDER=
HOLIDAY_PROVIDER=
# 도보 경로 Provider(카카오): fake | real
# 카카오맵 REST API를 활성화하고 REST API 키를 발급한 뒤 real로 변경한다.
# PROVIDER_MODE=real이어도 기본값은 fake로 유지된다 — 경로 API는 목적지 수만큼
# 호출하므로 비용이 커서, 이동수단마다 여기서 명시적으로 켠다.
TRAVEL_ROUTE_PROVIDER=fake
# 자동차 경로 Provider(네이버 지도 Directions 5): fake | real
# 공통값을 상속하지 않는다 — 도보와 벤더가 달라서, 상속시키면 카카오 키만 가진
# 설정이 네이버 키까지 요구하며 부팅에 실패한다. 켜려면 여기에 real을 적는다.
# NCP 콘솔에서 해당 Application에 Directions가 활성화되어 있어야 한다. 켜져 있지
# 않으면 게이트웨이는 통과하고 서비스가 403(본문 없음)을 준다.
TRAVEL_ROUTE_DRIVING_PROVIDER=fake
# 대중교통 경로 Provider(카카오): fake | real
# 도보와 같은 KAKAO_MAP_REST_API_KEY를 쓰지만 엔드포인트가 달라 호출량이 따로
# 늘어나므로 스위치를 따로 둔다. 요청에 출발 시각 파라미터가 없어 같은 구간은
# 언제 물어도 같은 값이 온다.
TRAVEL_ROUTE_TRANSIT_PROVIDER=fake
# 직선거리 fallback의 도보 예상시간 계산 속도(m/s).
WALKING_SPEED_MPS=1.2
# 자동차 fake의 직선거리 예상시간 계산 속도(m/s). 20km/h로, 검색 반경이 비도보
# 요청에 쓰는 가정과 같은 값이다. fake 값은 채점에 쓰이지 않는다.
DRIVING_SPEED_MPS=5.5
# 대중교통 fake도 같은 20km/h 가정을 쓴다 — 반경 산정이 비도보 요청을 이동수단으로
# 가르지 않기 때문이다.
TRANSIT_SPEED_MPS=5.5
# 도보·자동차·대중교통 경로 API 모두 목적지별 단건 호출이므로 동시 요청 수를 제한한다.
TRAVEL_ROUTE_MAX_CONCURRENCY=5
# SCHEDULE 구간이 이 도보 예상시간(분)을 넘으면 대중교통 추정으로 전환.
# 일정 편성이 추정 생성기를 부르기 전까지는 바꿔도 동작이 달라지지 않는다.
SCHEDULE_WALK_TRANSFER_THRESHOLD_MIN=20
# 한 번의 실측 요청에서 실제 경로 API로 잴 일정 구간 수 상한. 일정 하나가 3~5곳이면
# 구간은 2~4개이므로 기본 12는 유력 일정 3개까지를 덮는다. 넘는 구간은 호출하지 않고
# 추정값으로 남는다 — 올리면 외부 호출 수가 그만큼 늘어난다.
SCHEDULE_MAX_MEASURED_SEGMENTS=12

# 장소 후보별 상세·운영정보를 어디서 읽을지 고른다: supabase | tour_api
# - supabase: 미리 동기화된 places 테이블을 content_id로 한 번에 조회한다(기본값).
#             SUPABASE_URL / SUPABASE_SECRET_KEY가 필요하다.
# - tour_api: 후보마다 상세 API를 호출한다.
# 장소 후보 "검색"은 이 값과 무관하게 항상 PLACE_PROVIDER를 따른다.
# PLACE_PROVIDER가 fake이면 상세도 Fake Provider가 담당하므로 이 값은 무시된다.
#
# 추천은 후보 전량의 상세를 받아야 순위를 매길 수 있어(하드 필터가 운영시간을
# 요구한다) 이 값이 곧 호출 수를 정한다. 후보 30곳 기준 장소 조회 한 번의 외부
# 호출이 supabase는 2회(목록 1 + places 배치 1), tour_api는 61회다
# (목록 1 + detailCommon2 30 + detailIntro2 30). 그래서 tour_api에서 후보 한도를
# 10 초과로 두면 부팅이 막힌다 — TourAPI 일일 한도가 33요청 만에 소진되기 때문이다.
PLACE_DETAILS_SOURCE=supabase

# 빠른 구조화 판단(의도 분류·조건 추출) 모델. 기본값은 Lite로 비용·지연을 줄인다.
LLM_FAST_MODEL_NAME=gemini-3.5-flash-lite
# 빠른 모델 재시도 소진 시 사용할 대체 모델(쉼표 구분, 선택 사항)
LLM_FAST_FALLBACK_MODEL_NAMES=gemini-3.5-flash

# 사용자 답변·비교·일정 생성 모델. 문장 품질이 중요한 경로다.
LLM_GENERATION_MODEL_NAME=gemini-3.5-flash
# 생성 모델 재시도 소진 시 사용할 대체 모델(쉼표 구분, 선택 사항)
LLM_GENERATION_FALLBACK_MODEL_NAMES=gemini-3.5-flash-lite

# 장소 상세 카드의 "AI가 추천하는 이유" 문장 전용 모델. 카드를 클릭할 때 그 장소의
# 취향 태그·후기 근거만으로 1~2문장을 만든다.
#
# 위 두 티어와 따로 두는 이유는 특성이 다르기 때문이다 — 구조화 판단이 아니라 문장
# 생성이라 FAST가 아니고, 사용자가 기다리는 답변 본문이 아니라 클릭 후 한 줄이라
# GENERATION의 품질 예산을 쓸 이유도 없다. 사실 근거를 전부 쥐어주고 말투만 맡긴다.
#
# 기본값 근거(2026-09-09 실측, 실 데이터 1호출): 입력 762 · 출력 56토큰, 지연 1.5초,
# 사고 토큰 0. 3.5-flash-lite보다 출력 단가가 40% 싸다($1.50 대 $2.50 /1M).
PLACE_REASON_MODEL_NAME=gemini-3.1-flash-lite
# 재시도 소진 시 사용할 대체 모델(쉼표 구분, 선택 사항). 여기까지 실패하면 카드는
# 기존 고정 문장("...조건을 종합한 N순위 추천이에요.") 한 줄만 보여준다.
PLACE_REASON_FALLBACK_MODEL_NAMES=gemini-3.5-flash-lite
# false로 두면 이 호출이 통째로 사라지고 카드는 고정 문장만 보여준다.
# 비용·지연을 되돌리는 손잡이이자 문장 품질 문제의 즉시 차단 수단이다.
PLACE_REASON_ENABLED=true

# 구간 이동수단 판정(일정 구간·추천 후보가 걸을지 대중교통을 탈지) 전용 모델.
# 비우면 LLM_GENERATION_MODEL_NAME 묶음을 따른다.
#
# 기본값 근거(2026-09-15 실측, 34입력 × 5회): 3.5-flash와 틀린 판정이 0 대 0으로 같고
# 흔들림 0 대 2, 응답 p50 0.97초 대 1.31초, 1,000호출당 $0.47 대 $2.83.
# 프롬프트 mode_judge.select 1.1.0은 이 모델에 맞춰 잰 것이다 — 3.5-flash로 돌리면 추천
# 판정이 조금 더 흔들린다(backend/app/prompts/mode_judge/HISTORY.md).
#
# 같은 모델이 LLM_FAST_MODEL_NAME으로는 탈락했다(문맥 없는 첫 턴을 MODIFY로 분류한다,
# backend/test_results/fast_tier_2026-09-15/). 이 판정에만 쓴다.
MODE_JUDGE_MODEL_NAME=gemini-3.1-flash-lite
# 재시도 소진 시 사용할 대체 모델(쉼표 구분). 비우면 생성 모델 묶음 전체를 폴백으로 쓴다.
# 폴백까지 실패하면 판정 없이 거리 규칙(직선 850m 초과면 대중교통)으로 정한다.
MODE_JUDGE_FALLBACK_MODEL_NAMES=

# 음성 입력(음성→텍스트) 전용 Gemini 모델. 비우면 LLM_FAST_MODEL_NAME을 사용한다.
# 음성도 지원하는 Gemini 모델을 지정한다.
GEMINI_AUDIO_MODEL_NAME=

# LLM_MODEL_NAME / LLM_FALLBACK_MODEL_NAMES는 폐지됐다. 남아 있으면 부팅에서 막는다 —
# 값이 무시될 뿐 서버는 떠서, .env에 적힌 모델과 실제 호출되는 모델이 달라지기 때문이다.
# 위의 역할별 설정으로 옮긴다.

# 위의 각 Provider를 real로 설정했을 때만 필요한 인증 정보
LLM_API_KEY=
WEATHER_API_KEY=
TOUR_API_SERVICE_KEY=
# 영어 UI의 입력·응답 번역에 쓰는 Cloud Translation Basic(v2) API 키.
# Google Cloud Console에서 Cloud Translation API(translate.googleapis.com)를 활성화하고,
# 이 API가 허용된 서버 전용 키를 발급한다. Maps/Gemini 키와 분리해 관리한다.
GOOGLE_TRANSLATE_API_KEY=
# 관광공사 이미지가 없는 장소의 대표 사진을 가져오는 Places API(New) 키.
# Google Cloud Console에서 Places API (New)(places.googleapis.com)를 활성화하고,
# 이 API만 허용된 서버 전용 키를 발급한다. Translation/Gemini 키와 분리해 관리한다.
# GOOGLE_PLACE_PHOTO_ENABLED=false면 읽지 않는다.
GOOGLE_PLACES_API_KEY=
# NAVER_MAP_*는 지오코딩과 자동차 경로(Directions)가 같이 쓴다. 두 하위 API가
# 같은 Application에 각각 활성화되어 있어야 한다.
# 서울시 실시간 도시데이터/상권현황 API. SEOUL_CITYDATA_PROVIDER=real일 때 필요하다.
SEOUL_OPEN_DATA_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NAVER_LOCAL_SEARCH_CLIENT_ID=
NAVER_LOCAL_SEARCH_CLIENT_SECRET=
LOCAL_SEARCH_PROVIDER=fake

# 카카오맵 도보 경로 REST API 인증
# - KAKAO_MAP_REST_API_KEY: 카카오디벨로퍼스에서 발급한 REST API 키.
#   요청 시 `Authorization: KakaoAK {키}` 헤더로 사용하며 프론트엔드에 노출하지 않는다.
# 공식 단건 도보 경로 엔드포인트: https://dapi.kakao.com/v2/routing/walk
KAKAO_MAP_REST_API_KEY=

# Supabase 서버 전용 저장소 설정. Secret Key는 프론트엔드에 노출하지 않는다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Package B의 State(세션 상태·이력·트레이스) 저장소 백엔드: memory | supabase
# - memory: 프로세스 메모리에 저장한다(기본값). 서버 재시작 시 소멸한다.
# - supabase: DB에 영구 저장한다. SUPABASE_URL / SUPABASE_SECRET_KEY가 필요하다.
STATE_STORE_BACKEND=memory

# 후기·블로그 데이터 기능 전체의 스위치(선택 기능). 켜면 사용자 발화의 취향을
# 블로그·리뷰 임베딩과 비교해 추천 순위에 taste 축을 더하고, 아래 기능이 함께 켜진다.
# false면 이것들이 모두 멈추고 취향 없이 나머지 축으로 추천한다.
# - 취향 임베딩 검색과 취향 태그 채점(추천 순위의 taste 축, 저장한 취향 반영 포함)
# - 추천 카드의 preference_tags(장소별 방문자 취향 태그 표)
# - 상세 카드의 방문자 후기 특징(preference_insights)과 AI 추천 이유(ai_reason)
# - 후기로 답하는 INFO 질의(REVIEW_ANSWER_ENABLED) — 끄면 관광 API 개요로 답한다
# - 프론트의 "취향 설정" 메뉴와 /preferences 화면(GET /api/features로 전달)
# 저장해 둔 취향(user_preferences)은 지우지 않는다. 다시 켜면 그대로 쓰인다.
# 임베딩 검색까지 켜려면 세 가지가 모두 필요하다.
# - 이 값을 true로 둔다.
# - SUPABASE_URL / SUPABASE_SECRET_KEY (place_embeddings·search_place_evidence RPC 접근).
# - 임베딩 모델 설치: `pip install -e ".[embeddings]"` (ko-sroberta, 프로세스 상주
#   RSS 약 537MB). 미설치 상태로 켜면 예열이 실패하고 취향만 꺼진 채 서버는 뜬다.
TASTE_EVIDENCE_ENABLED=false

# 관광공사 이미지가 없는 장소를 Google Places 사진으로 채울지 여부(선택 기능).
# places 8,067건 중 844건이 대표 이미지·썸네일이 둘 다 비어 있고, 그중 843건은
# 추가 사진도 없다(2026-09-20 실측). 추천 후보로 쓰이는 활성 장소만 세면 607곳이
# 지금 카드에서 회색 자리표시로 나온다. 켜면 그 장소에만 Google 사진을 붙인다.
# false면 지금처럼 자리표시가 나오고 Google 호출은 한 번도 없다.
# 켜려면 두 가지가 필요하다.
# - 이 값을 true로 둔다.
# - GOOGLE_PLACES_API_KEY (키가 비어 있으면 경고만 남기고 꺼진 것으로 둔다).
# 비용: 이미지가 없는 장소 1곳당 호출 2회(장소 검색 1 + 사진 주소 1)다. 이미지가
# 있는 장소는 호출하지 않는다. 받은 주소는 DB에 저장하지 않고 프로세스 메모리에만
# GOOGLE_PLACE_PHOTO_CACHE_TTL_SECONDS 동안 둔다 — Google 정책상 사진과 사진 이름을
# 영구 저장할 수 없고 주소도 만료되기 때문이다.
GOOGLE_PLACE_PHOTO_ENABLED=false

# 장소 사진 분위기(선택 기능): 올린 사진과 분위기가 닮은 장소를 찾는다
# (POST /api/places/similar-by-photo, 채팅창 "+" 버튼). 리뷰나 컬럼에 적힌 적 없는
# 공간의 인상을 다루므로 텍스트 검색으로는 찾을 수 없는 이웃이 나온다 — 카페를
# 넣으면 갤러리·소극장이 올라온다. false면 그 엔드포인트만 503이고 나머지는 그대로다.
# 켜려면 세 가지가 모두 필요하다.
# - 이 값을 true로 둔다.
# - SUPABASE_URL / SUPABASE_SECRET_KEY (place_mood_vectors·search_place_mood RPC 접근).
# - 임베딩 모델 설치: `pip install -e ".[mood]"` (SigLIP 2, 프로세스 상주). 미설치
#   상태로 켜면 로그에 이유를 남기고 사진 검색만 꺼진 채 서버는 뜬다.
PLACE_MOOD_ENABLED=false

# 사진 임베딩 모델을 서버 기동 때 미리 올릴지. 적재가 실측 44초라 끄면 첫 사진
# 요청이 그 시간을 그대로 뒤집어쓴다(예열 뒤에는 1.2초). PLACE_MOOD_ENABLED가
# 꺼져 있으면 무시된다.
PLACE_MOOD_WARMUP_ENABLED=false

# 사진 검색 결과를 VLM(Gemini)에게 다시 줄 세우게 할지(TP-214). PLACE_MOOD_ENABLED와
# LLM_API_KEY가 함께 있어야 하고, LLM이 fake 모드면 켜도 무시된다.
#
# **돈이 든다.** 검색 한 번에 16~47원이고 하루 500회면 월 24만원이다. 품질은 사람
# 눈가림 채점에서 31.6% → 38.5%로 올랐다(후보 12곳 기준). 실패해도 검색은 죽지
# 않는다 — 임베딩 순서를 그대로 낸다.
PLACE_MOOD_RERANK_ENABLED=false

# 재랭킹에 쓸 모델. 비우면 LLM_FAST_MODEL_NAME을 따른다. **flash급이어야 한다** —
# flash-lite로 내리면 개선이 +6.8%p에서 +0.9%p로 사라진다(TP-213).
PLACE_MOOD_RERANK_MODEL_NAME=

# VLM에 보낼 후보 수. **보여줄 수(5곳)보다 넉넉해야 한다** — 같으면 재랭커가 순서만
# 바꾸고 뽑히는 곳은 그대로라 이득이 0이다. 상위 5곳 기준 실측에서 여유가 클수록
# 이득이 커졌다: 6곳 +2.1%p(p = 0.128) · 8곳 +4.1%p(p = 0.050) · 10곳 +5.7%p(p = 0.006).
# 12곳은 늘릴 근거가 없다 — 유일한 실측이 10곳보다 낮았다. 토큰은 후보 1곳당
# 1,083개씩 붙고 사진 해상도는 영향이 없다.
PLACE_MOOD_RERANK_CANDIDATE_COUNT=10

# 1위 유사도가 이 값 미만이면 VLM을 부르지 않는다. 닮은 곳이 DB에 없다는 뜻이라
# 순서를 바꿔봐야 나아지지 않는다. 0.525에서 호출이 64%로 줄고 품질은 0.50과 같다
# (둘 다 +4.1%p, p = 0.008). 0.55부터는 도움이 되는 질의까지 잘라내 유의성을 잃는다.
# **PLACE_MOOD_MEAN_CENTER_ENABLED가 켜져 있을 때의 눈금이다.**
PLACE_MOOD_RERANK_MIN_TOP_SIMILARITY=0.525

# 실시간 인구 혼잡도 조회가 우리 지역 목록(121곳)엔 없는데 서울시 API는 지원하는
# 지역을 찾아내는 probe 기능(TP-141, D-083). 응답은 안 바꾸고 개발자 화면에만
# 배너로 알린다. 기본 true. probe가 서울시 API를 하나 더 부르므로, 트래픽이
# 예상보다 늘면 false로 끈다.
SEOUL_AREA_STALENESS_PROBE_ENABLED=true

# 장소 동기화 기본값: 서울 종로구
PLACE_SYNC_PAGE_SIZE=100
PLACE_SYNC_DETAIL_CONCURRENCY=5
PLACE_SYNC_DETAIL_TTL_DAYS=30
PLACE_SYNC_AREA_CODE=11
PLACE_SYNC_DISTRICT_CODE=110

# 상세조회 호출 간 최소 간격(초). 0이면 간격을 두지 않는다.
# TourAPI는 초당 한도와 일일 한도를 따로 두는데, detailIntro2 응답이 100ms대라
# 동시성을 1로 낮춰도 초당 8회쯤 나가 초당 한도에 걸린다(2026-08-10 실측).
# 평소에는 0으로 두고, 전량 재조회(--force-details)처럼 대량 실행에서만 올려 쓴다.
# 예: PLACE_SYNC_DETAIL_MIN_INTERVAL_SECONDS=0.15  (초당 약 6~7회)
PLACE_SYNC_DETAIL_MIN_INTERVAL_SECONDS=0

# 정규식이 못 읽은 휴무 문구를 LLM으로 읽을지(TP-231). **적재 배치에서만 본다** —
# 화면 요청은 저장된 파싱 결과를 읽으므로 켜도 응답이 느려지지 않는다.
#
# 기본값이 true다. 끄면 `2,4주 일요일`처럼 주차가 섞인 문구를 못 읽어, 쉬는 날에도
# 문 여는 곳으로 채점되는 장소가 399곳 남는다. 전량을 부르지 않고 정규식이 아무것도
# 못 읽은 것만 부르며, LLM이 fake 모드면 켜도 무시된다.
CLOSURE_EXTRACT_ENABLED=true


# IP별 요청 빈도 제한. /api/chat은 인증 없이 호출할 수 있고 호출마다 LLM 요금이
# 발생해서, 공개 배포에서는 켜야 한다. 기본이 꺼짐인 이유는 테스트가 같은
# 클라이언트에서 채팅 요청을 연달아 보내기 때문이다.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# 쉼표로 여러 개. /api/health를 넣으면 배포 헬스체크가 막힌다.
RATE_LIMIT_PATH_PREFIXES=/api/chat

# 실제 Provider의 HTTP 동작 설정이며 fake Provider에서는 사용하지 않는다.
# TourAPI/Naver/Supabase(장소 상세·상태 저장소 등) 조회에 적용된다 — 원래 짧게
# 끝나야 하는 단순 조회라 값을 너무 크게 잡으면 실패 시 사용자가 그만큼 오래
# 기다리게 된다.
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_RETRY_COUNT=2

# LLM(Gemini) 호출 전용 타임아웃(초). 비어 있으면 EXTERNAL_API_TIMEOUT_SECONDS를
# 그대로 쓴다. Gemini는 구조화 출력 생성 특성상 Tool/DB 조회보다 오래 걸릴 수
# 있어 EXTERNAL_API_TIMEOUT_SECONDS와 분리했다(2026-08-11) — Gemini 호출이 느려
# EXTERNAL_API_TIMEOUT_SECONDS를 올리면 TourAPI/Naver/Supabase까지 같이 오래
# 기다리게 되는 문제가 있었다.
# 예: LLM_API_TIMEOUT_SECONDS=25
LLM_API_TIMEOUT_SECONDS=

# --- LLMOps 관측 (Langfuse) — roadmap 13번 -----------------------------------
# **공모전 배포에서는 두 스위치를 모두 끈 채로 둔다**(2026-09-20). 특히
# LANGFUSE_PROMPTS_ENABLED 를 켜면 안 된다 — 이 저장소와 본 저장소가 같은
# Langfuse 프로젝트를 보고 있어서, 켜 두면 본 저장소 팀이 프롬프트를 고치는
# 순간 배포도 하지 않은 공모전 서버의 답변이 바뀐다. 실제로 서버에서 켜져
# 있던 것을 심사 전에 껐다(docs/deploy.md "Langfuse" 절).
#
# 스위치가 두 개인 것이 요점이다. LANGFUSE_ENABLED는 "전송을 하느냐",
# LANGFUSE_CAPTURE_CONTENT는 "발화·응답 원문을 실어 보내느냐"다. 하나로 묶으면
# 배포 환경에서 지연·토큰만 보고 원문은 빼는 선택을 할 수 없다.
#
# 둘 다 기본 꺼짐이다. 지금은 실사용자가 없어 나가는 게 팀원 자기 발화뿐이지만,
# 그 조건에서 정한 기본값이 배포 이후까지 살아남으면 남의 발화가 그대로 외부로
# 나간다. 배포 시점에 CAPTURE_CONTENT를 반드시 다시 판단한다.
#
# **안 쓸 사람은 아무것도 안 해도 된다.** 아래 아홉 줄이 .env에 없어도 되고,
# langfuse 패키지를 설치하지 않아도 된다 — 최상위 import가 한 곳도 없고 전부
# get_tracer() 안의 지연 import다. 켠 사람만 설치가 필요하다.
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false

# 세 번째 축이다. 원문을 가려도 user_id는 trace 속성이라 mask를 타지 않으므로,
# CAPTURE_CONTENT에 묶어두면 "발화는 가리고 신원만 쌓는" 상태가 실수로 만들어진다.
# 게스트도 user_id를 갖는다(D-062) — 그것도 외부로 나가는 식별자라 같은 스위치를
# 탄다. 개인정보를 외부 SaaS에 올리는 일이라 켜는 것은 팀 합의가 먼저다.
LANGFUSE_CAPTURE_USER_ID=false

# 이 서버가 만든 턴에 `developer:<값>` 태그를 붙인다. 팀원 넷이 같은 Langfuse
# 프로젝트를 공유하면 Traces 목록에서 누가 만든 턴인지 구분이 안 되므로,
# **각자 자기 GitHub 핸들을 넣는다**(예: rayquaza410). Langfuse 화면에서
# 태그로 필터하면 자기 트레이스만 남는다.
#
# ⚠️ APP_ENV를 사람마다 다르게 바꾸는 방법은 쓰지 않는다. 그건 관측 라벨이 아니라
# 기능 게이트다 — main.py가 정확히 "local"과 비교해 개발자 Ops 라우터(/api/dev/*)를
# 등록할지 정하므로, 값을 바꾸면 그 라우터가 통째로 사라진다.
#
# 비워두면 태그를 안 붙인다. CAPTURE_USER_ID와 달리 시스템이 뽑는 식별자가 아니라
# 본인이 적는 핸들이라 개인정보 축이 아니다.
LANGFUSE_DEVELOPER=

# cloud.langfuse.com 프로젝트 설정에서 발급한다. pk-lf-... / sk-lf-...
# ENABLED=true인데 비어 있으면 부팅이 실패한다(첫 요청까지 숨지 않게).
# 패키지 미설치도 같이 막는다 — 설정만 검사하면 "켰는데 조용히 안 쌓이는" 상태가
# 며칠 간다(실제로 CallbackHandler가 그렇게 조용히 꺼진 적이 있다).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ⚠️ 가입한 리전과 반드시 같아야 한다 — 키는 리전별로 발급되므로 EU 계정 키를
# JP 엔드포인트로 보내면 인증이 안 된다.
#   EU  https://cloud.langfuse.com      (기본 도메인)
#   US  https://us.cloud.langfuse.com
#   JP  https://jp.cloud.langfuse.com   (한국에서 지연 최소)
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# --- 프롬프트를 Langfuse에서 읽기 --------------------------------------------
# 전송(LANGFUSE_ENABLED)과 **별개 축이다.** 관측을 끄고 프롬프트만 쓸 수도, 그
# 반대도 된다. 켜면 app/prompts/ 의 자산 43개를 Langfuse에서 먼저 읽고, 못
# 가져오면 레포의 Markdown으로 돌아간다 — 켜도 Langfuse가 죽으면 서비스는 돈다.
# 키는 위와 같은 것을 쓴다.
#
# **켜기 전에 레포와 원격이 같은지 먼저 본다.** 어긋난 채로 켜면 화면에서 읽는
# 원문과 실제로 도는 원문이 달라진다:
#   cd backend && .venv/bin/python -m scripts.sync_langfuse_prompts --check
LANGFUSE_PROMPTS_ENABLED=false

# 원격 프롬프트를 몇 초 캐시할지. 만료돼도 요청은 안 막힌다 — SDK가 백그라운드로
# 갱신하고 기존 값을 즉시 돌려준다. 짧게 잡으면 Langfuse에서 고친 프롬프트가 그만큼
# 빨리 반영되고, 길게 잡으면 왕복이 준다.
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# 추천 파이프라인 후보 예산 (필요 시 조정 가능, 후보 상한은 30)
# 후보 수를 낮추면 밤 시간대에 영업 종료로 걸러진 뒤 결과 5곳을 못 채운다
# (반경 2km 실측: 후보 10곳이면 경복궁 21시에 통과 1곳).
RECOMMENDATION_RESULT_LIMIT=5
RECOMMENDATION_CANDIDATE_LIMIT=30

# Fake Provider가 내려줄 고정 날씨 "사실" — 기상청 코드를 그대로 쓴다(D-051).
# 판정(good/neutral/bad)은 D가 사용자 의도까지 보고 내리므로 여기서 지정하지 않는다.
# SKY: 1 맑음 / 3 구름많음 / 4 흐림, PTY: 0 없음 / 1 비 / 2 비눈 / 3 눈
# 기본값(4, 0)은 판정을 어느 쪽으로도 밀지 않는 중립 조합이다.
FAKE_WEATHER_SKY_CODE=4
FAKE_WEATHER_PRECIPITATION_TYPE=0

# PLACE_PROVIDER=fake일 때 추천 로직이 현재 시각으로 사용할 값
# app/core/clock.py에서 사용하며 시간대 없는 ISO 8601 형식으로 입력한다.
# PLACE_PROVIDER=real이면 실제 시각을 사용하므로 이 값은 무시된다.
# Fake 추천 결과를 재현할 수 있도록 장소가 운영 중인 평일 낮 시간으로 고정한다.
FAKE_CURRENT_DATETIME=2026-07-15T14:00:00
