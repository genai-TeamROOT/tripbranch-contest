# 선택 항목입니다. 비워두면 API 클라이언트는 동일 출처의 "/api"를 사용합니다.
# 로컬에서는 Vite 개발 서버 프록시를 사용하고, 배포 후에는 같은 도메인 라우팅을 기대합니다.
VITE_API_BASE_URL=

# 채팅 흐름 안에서 구조화된 입력 해석 디버그 카드를 표시합니다.
# 릴리즈 빌드에서는 false로 설정하세요.
VITE_SHOW_INTERPRETATION_DEBUG=true

# 게스트 로그인(D-062)용 Supabase 신원 발급 설정입니다.
# 실제 값은 .env.local에 둡니다. publishable key는 브라우저에 노출되는 전제의
# 키이며, SUPABASE_SECRET_KEY는 여기에도 .env.local에도 두지 않습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
